{
    "id": "io.github.gwords.Gwords",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "gwords",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/gwords/cargo",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig"
    ],
    "modules": [
        {
            "name": "gwords",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release --locked",
                "install -Dm755 target/release/gwords -t /app/bin/",
                "install -Dm644 data/io.github.gwords.Gwords.desktop -t /app/share/applications/",
                "install -Dm644 data/io.github.gwords.Gwords.metainfo.xml -t /app/share/metainfo/",
                "install -Dm644 data/icons/hicolor/scalable/apps/io.github.gwords.Gwords.svg -t /app/share/icons/hicolor/scalable/apps/",
                "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.gwords.Gwords-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps/"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        "target",
                        ".flatpak-builder",
                        "build-dir",
                        "repo",
                        "gwords.flatpak"
                    ]
                },
                "build-aux/cargo-sources.json"
            ]
        }
    ]
}
